# =============================================================================
# TheoGen Electoral — Plantilla de Variables de Entorno para PRODUCCIÓN
# =============================================================================
# INSTRUCCIONES:
# 1. Copie este archivo como ".env" en la raíz del proyecto en su servidor.
# 2. Reemplace CADA UNO de los valores con secretos generados criptográficamente.
# 3. Asigne permisos estrictos: chmod 600 .env
# 4. NUNCA suba este archivo al control de versiones Git.
# =============================================================================

# --- Entorno Operacional ---
ENVIRONMENT=production

# --- Base de Datos PostgreSQL 16 ---
POSTGRES_DB=theogen_electoral
POSTGRES_USER=theogen
# Genere con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_GENERADA_32_CHARS

# Conexión interna utilizada por el backend FastAPI
# El rol app no es propietario, superusuario ni migrador. No reutilice POSTGRES_USER.
APP_DB_PASSWORD=CAMBIAR_POR_PASSWORD_APP
DATABASE_URL=postgresql://theogen_app:${APP_DB_PASSWORD}@db:5432/theogen_electoral
# Solo el servicio --profile release recibe esta URL. No incluirla en .env.backend.
MIGRATOR_DB_PASSWORD=CAMBIAR_POR_PASSWORD_MIGRADOR
MIGRATION_DATABASE_URL=postgresql://theogen_migrator:${MIGRATOR_DB_PASSWORD}@db:5432/theogen_electoral
RUN_MIGRATIONS_ON_STARTUP=false

# --- Seguridad Criptográfica de la Plataforma ---
# Clave maestra para la firma de tokens JWT (HS256)
# Genere con: python3 -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CAMBIAR_POR_TOKEN_HEX_64_ALEATORIO

# Clave secreta privada para generación de hashes de comprobantes de voto (HMAC-SHA256)
# Genere con: python3 -c "import secrets; print(secrets.token_hex(32))"
VOTE_HMAC_KEY=CAMBIAR_POR_TOKEN_HEX_32_ALEATORIO

# Derechos electorales: clave persistente independiente; misma en todos los workers.
# Genere una vez, respalde fuera de PostgreSQL y ensaye su recuperación.
ENTITLEMENT_HMAC_KEY=CAMBIAR_POR_OTRO_TOKEN_HEX_32_ALEATORIO

# Brevo: habilitar solo tras integrar y probar el ciclo completo de credenciales.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=theogen@nubeweb.cl
BREVO_SENDER_NAME=TheoGen Electoral
BREVO_DELIVERY_ENABLED=false
PUBLIC_VOTING_URL=

# --- Dominio y URLs Públicas ---
DOMAIN=votaciones.theogen.cl
PUBLIC_URL=https://votaciones.theogen.cl
API_PUBLIC_URL=https://votaciones.theogen.cl/api

# --- Respaldos Automatizados ---
BACKUP_DIR=/var/backups/theogen
BACKUP_RETENTION_DAYS=30
