# =============================================================================
# TheoGen Electoral — Variables de Entorno
# =============================================================================
# Copie este archivo como ".env" y configure los valores reales.
# NUNCA incluya el archivo .env en el repositorio.
# =============================================================================

# --- Base de datos PostgreSQL ---
POSTGRES_DB=theogen_electoral
POSTGRES_USER=theogen
# Genere con: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=CHANGE_ME_generate_a_strong_password

# --- Backend ---
DATABASE_URL=postgresql://theogen:${POSTGRES_PASSWORD}@db:5432/theogen_electoral
ENVIRONMENT=production

# Genere con: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_64

# Genere con: python -c "import secrets; print(secrets.token_hex(32))"
VOTE_HMAC_KEY=CHANGE_ME_generate_with_secrets_token_hex_32

# Clave persistente distinta de las dos anteriores. Respaldar fuera de la BD.
# Genere una vez con: python -c "import secrets; print(secrets.token_hex(32))"
ENTITLEMENT_HMAC_KEY=CHANGE_ME_generate_an_independent_persistent_key

# Brevo: cargar API key desde configuración privada o gestor de secretos.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=theogen@nubeweb.cl
BREVO_SENDER_NAME=TheoGen Electoral
BREVO_DELIVERY_ENABLED=false
PUBLIC_VOTING_URL=
