# =============================================================================
# TheoGen Electoral — .gitignore
# =============================================================================

# Entornos virtuales de Python
.runtime/
frontend/test-results/
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# Byte-compiled / optimizados
__pycache__/
*.py[cod]
*$py.class
backend/__pycache__/
backend/**/__pycache__/

# Dependencias Node.js
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Compilados de Frontend
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
*.local

# Variables de entorno y secretos
.env
.env.*
!.env.example
!.env.production.example
*.env

# Bases de datos locales
*.db
*.sqlite
*.sqlite3
backend/*.db
backend/*.sqlite3

# Logs
logs/
*.log
*.log.*

# Editores e IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini
